HOST=0.0.0.0
PORT=3001

# 개발 모드에서는 Vite와 API 서버가 서로 다른 포트를 사용합니다.
WEB_ORIGIN=http://localhost:5173
VITE_SERVER_URL=http://localhost:3001

# 운영 단일 서비스에서는 빌드된 웹 앱 경로만 지정하면 됩니다.
# WEB_ORIGIN과 VITE_SERVER_URL을 비우면 브라우저와 Socket.IO가 같은 도메인을 사용합니다.
WEB_ROOT=
GAME_ASSET_ROOT=

# 선택 사항: 비우면 등록된 장면 중 하나를 무작위로 사용합니다.
GAME_SCENE_ID=

# 로컬 Docker PostgreSQL 전용 예시입니다. 운영 비밀번호로 재사용하지 마세요.
POSTGRES_PASSWORD=spot-battle-local-only
DATABASE_URL=postgresql://postgres:spot-battle-local-only@localhost:5432/spot_difference_battle
