{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@spot-battle/shared": ["../packages/shared/src/index.ts"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "../packages/shared/src",
    "vite.config.ts",
    "granite.config.ts"
  ]
}
