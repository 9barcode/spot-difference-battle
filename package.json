{
  "name": "spot-difference-battle",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter @spot-battle/shared --filter @spot-battle/game-core build",
    "precheck": "pnpm build:packages",
    "check": "pnpm -r --if-present check",
    "predev": "pnpm build:packages",
    "dev": "pnpm --parallel --filter @spot-battle/web --filter @spot-battle/server dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium firefox webkit",
    "setup": "pnpm install && pnpm build:packages",
    "pretest": "pnpm build:packages",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
